# Generate a random database password: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Exact public HTTPS origin. Every visitor registers their own account here.
DASHBOARD_ORIGINS=https://prowhatsappapprover.tech
# Only needed to claim the ORIGINAL single-owner workspace after an upgrade.
# Keep your existing value when upgrading. It is no longer an API credential.
ADMIN_API_KEY=
APPROVAL_BATCH_SIZE=10
APPROVAL_BATCH_DELAY_MS=250
BIND_PORT=18081
# Simultaneous background WhatsApp connections. Size this for your VPS resources.
MAX_CONNECTED_ACCOUNTS=20
